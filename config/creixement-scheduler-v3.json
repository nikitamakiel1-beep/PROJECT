{
  "schema_version": "3.0.0",
  "timezone": "Europe/Madrid",
  "runtime": "cloud_only",
  "queue_model": "postgres_leased_jobs_plus_outbox",
  "default_retry": {
    "max_attempts": 3,
    "base_delay_seconds": 30,
    "max_delay_seconds": 900,
    "jitter_pct": 0.15
  },
  "default_circuit_breaker": {
    "failure_threshold": 5,
    "cooldown_seconds": 900
  },
  "jobs": [
    {
      "job_key": "chief_operator_priority_compile",
      "name": "Chief Operator Priority Compile",
      "trigger_type": "cron",
      "schedule_expr": "0 7 * * *",
      "handler_key": "chief.compile_priorities",
      "owner_agent": "chief-orchestrator",
      "autonomy_level": "L1",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 300,
      "max_attempts": 3,
      "concurrency_limit": 1
    },
    {
      "job_key": "runtime_connector_health",
      "name": "Connector Runtime Health",
      "trigger_type": "cron",
      "schedule_expr": "*/30 * * * *",
      "handler_key": "automation.connector_health",
      "owner_agent": "automation-engineer",
      "autonomy_level": "L1",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 180,
      "max_attempts": 2,
      "concurrency_limit": 1
    },
    {
      "job_key": "opportunity_signal_consumer",
      "name": "Opportunity Signal Consumer",
      "trigger_type": "event",
      "event_topic": "opportunity.signal",
      "handler_key": "opportunity.consume_signal",
      "owner_agent": "opportunity-hunter",
      "autonomy_level": "L2",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 600,
      "max_attempts": 5,
      "concurrency_limit": 4
    },
    {
      "job_key": "opportunity_radar_refresh",
      "name": "Opportunity Radar Refresh",
      "trigger_type": "cron",
      "schedule_expr": "15 */4 * * *",
      "handler_key": "opportunity.refresh_radar",
      "owner_agent": "opportunity-hunter",
      "autonomy_level": "L1",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 600,
      "max_attempts": 3,
      "concurrency_limit": 1
    },
    {
      "job_key": "commercial_genome_evolution",
      "name": "Commercial Genome Evolution",
      "trigger_type": "cron",
      "schedule_expr": "30 6 * * 1",
      "handler_key": "evolution.evaluate_niches",
      "owner_agent": "evolution",
      "autonomy_level": "L2",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 900,
      "max_attempts": 2,
      "concurrency_limit": 1,
      "guard": "mutate_only_when_verified_observation_threshold_is_met"
    },
    {
      "job_key": "counterparty_freshness_sweep",
      "name": "Counterparty Freshness Sweep",
      "trigger_type": "cron",
      "schedule_expr": "0 5 * * *",
      "handler_key": "counterparty.refresh_staleness",
      "owner_agent": "counterparty",
      "autonomy_level": "L1",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 300,
      "max_attempts": 2,
      "concurrency_limit": 1
    },
    {
      "job_key": "crm_pipeline_sync",
      "name": "CRM Pipeline Sync",
      "trigger_type": "cron",
      "schedule_expr": "*/15 * * * *",
      "handler_key": "commercial.sync_crm",
      "owner_agent": "commercial",
      "autonomy_level": "L2",
      "required_connectors": ["google-sheets-crm"],
      "enabled": false,
      "enable_when": "runtime_connector_is_authenticated_and_health_verified",
      "max_runtime_seconds": 300,
      "max_attempts": 5,
      "concurrency_limit": 1
    },
    {
      "job_key": "funding_radar_refresh",
      "name": "Funding Radar Refresh",
      "trigger_type": "cron",
      "schedule_expr": "30 7 * * *",
      "handler_key": "funding.refresh_calls",
      "owner_agent": "funding",
      "autonomy_level": "L1",
      "required_connectors": ["funding-feeds"],
      "enabled": false,
      "enable_when": "approved_funding_feed_runtime_is_wired",
      "max_runtime_seconds": 900,
      "max_attempts": 3,
      "concurrency_limit": 1
    },
    {
      "job_key": "market_intelligence_refresh",
      "name": "Market Intelligence Refresh",
      "trigger_type": "event",
      "event_topic": "market.research.requested",
      "handler_key": "market.research",
      "owner_agent": "market-intelligence",
      "autonomy_level": "L2",
      "required_connectors": ["market-data"],
      "enabled": false,
      "enable_when": "approved_market_data_runtime_is_wired",
      "max_runtime_seconds": 1200,
      "max_attempts": 3,
      "concurrency_limit": 3
    },
    {
      "job_key": "tectum_underwriting",
      "name": "Tectum Cloud Underwriting",
      "trigger_type": "event",
      "event_topic": "tectum.case.ready_for_underwriting",
      "handler_key": "tectum.underwrite",
      "owner_agent": "tectum",
      "autonomy_level": "L2",
      "required_connectors": ["tectum-cloud-underwriting"],
      "enabled": false,
      "enable_when": "golden_case_equivalence_and_runtime_health_pass",
      "max_runtime_seconds": 600,
      "max_attempts": 3,
      "concurrency_limit": 3
    },
    {
      "job_key": "tectum_report_render",
      "name": "Tectum Cloud Report Render",
      "trigger_type": "event",
      "event_topic": "tectum.case.ready_for_report",
      "handler_key": "tectum.render_report",
      "owner_agent": "tectum",
      "autonomy_level": "L2",
      "required_connectors": ["tectum-cloud-renderer"],
      "enabled": false,
      "enable_when": "golden_report_fidelity_and_runtime_health_pass",
      "max_runtime_seconds": 900,
      "max_attempts": 3,
      "concurrency_limit": 2
    },
    {
      "job_key": "dead_letter_triage",
      "name": "Dead Letter Triage",
      "trigger_type": "cron",
      "schedule_expr": "10 * * * *",
      "handler_key": "automation.dead_letter_triage",
      "owner_agent": "automation-engineer",
      "autonomy_level": "L1",
      "required_connectors": [],
      "enabled": true,
      "max_runtime_seconds": 180,
      "max_attempts": 1,
      "concurrency_limit": 1
    }
  ]
}
