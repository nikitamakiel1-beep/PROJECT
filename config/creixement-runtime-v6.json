{
  "schema_version": "6.1.0",
  "runtime": {
    "cloud_only": true,
    "package": "cloud/creixement-runtime",
    "entrypoints": {
      "tick": "/api/tick",
      "health": "/api/health",
      "readiness": "/api/readiness",
      "owner_decisions": "/api/owner-decisions",
      "release_status": "/api/release-status"
    },
    "tick_target_minutes": 5,
    "recovery_lookback_minutes": 1500,
    "native_vercel_hobby_safety_cron": "17 3 * * *",
    "continuous_scheduler_required": true,
    "continuous_scheduler_state_source": "scheduler_bindings_v6",
    "authentication": {
      "scheduler": "Bearer CRON_SECRET",
      "operator_read": "Bearer CREIXEMENT_API_TOKEN",
      "owner_decision": "Bearer CREIXEMENT_OWNER_TOKEN"
    },
    "database_request_timeout_ms_default": 8000
  },
  "required_server_secrets": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "CRON_SECRET",
    "CREIXEMENT_API_TOKEN",
    "CREIXEMENT_OWNER_TOKEN"
  ],
  "optional_server_configuration": {
    "CREIXEMENT_DB_TIMEOUT_MS": "1000..30000; default 8000",
    "CREIXEMENT_RUNTIME_ID": "stable runtime instance identifier",
    "CREIXEMENT_RUNTIME_VERSION": "defaults to 0.6.1",
    "CREIXEMENT_COMMIT_SHA": "fallback commit attestation when platform metadata is absent"
  },
  "execution": {
    "event_outbox_routing": true,
    "fail_closed_unknown_handlers": true,
    "handler_circuit_breakers": true,
    "single_probe_half_open_circuits": true,
    "connector_readiness_required": true,
    "runtime_control_required": true,
    "budget_reservation_required": true,
    "budget_timezone": "Europe/Madrid",
    "execution_receipt_required": true,
    "idempotency_required": true,
    "owner_idempotency_conflict_rejected": true,
    "job_leasing_required": true,
    "expired_lease_recovery": true,
    "job_concurrency_limits_enforced": true,
    "retry_backoff_required": true,
    "job_dead_letter_required": true,
    "outbox_dead_letter_required": true,
    "heartbeat_required": true,
    "desired_state_reconciliation": true,
    "drift_history_preserved": true
  },
  "owner_boundary": {
    "decision_ingress_is_execution": false,
    "decisions_are_immutable": true,
    "decisions_emit_events": true,
    "downstream_policy_recheck_required": true,
    "non_delegable_actions_remain_owner_only": true
  },
  "release": {
    "migration_head": "012_v6_resilience_and_release_integrity.sql",
    "runtime_version": "0.6.1",
    "ci_success_required": true,
    "healthy_runtime_required": true,
    "high_frequency_scheduler_required": true,
    "critical_drift_allowed": 0,
    "critical_incidents_allowed": 0,
    "open_job_dead_letters_allowed": 0,
    "open_outbox_dead_letters_allowed": 0,
    "open_handler_circuits_allowed": 0,
    "enabled_job_connector_blockers_allowed": 0,
    "machine_attestation_table": "release_attestations_v6",
    "production_gate_view": "v_production_gate_v6"
  },
  "external_effects": {
    "outreach_enabled": false,
    "publication_enabled": false,
    "payments_enabled": false,
    "contracts_enabled": false,
    "property_commitments_enabled": false
  }
}
