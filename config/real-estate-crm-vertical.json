    "property_match_priority": ["source system plus source record reference", "restricted cadastral hash", "location hash plus property characteristics", "human decision"],
    "deal_match_priority": ["source system plus source record reference", "property ID plus strategy plus period", "human decision"],
    "weak_single_key_overwrite_permitted": false,
    "ambiguous_match_action": "quarantine",
    "missing_authority_action": "quarantine",
    "formula_without_cached_value_action": "quarantine",
