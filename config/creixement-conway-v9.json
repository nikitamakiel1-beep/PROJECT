{
  "schema_version": "9.2.0",
  "name": "Kairon Conway Ecology",
  "migration_head": "021_v9_runtime_proof_and_scheduler_autoverify.sql",
  "runtime_version": "0.9.2",
  "slime_mold_court": {
    "max_paths": 200000,
    "deterministic_ordering": true,
    "authority_graph_traversal": true,
    "forbidden_l3_terminal": true
  },
  "faustian_court": {
    "hard_veto_dominates_expected_value": true,
    "fuzz_high_value_unsafe_paths": true,
    "constitutional_fields_never_advisory": true
  },
  "hysteresis": {
    "enter_threshold": 0.7,
    "exit_threshold": 0.4,
    "dwell_enter": 2,
    "dwell_exit": 2,
    "purpose": "prevent capability/state flapping and volatile public projection"
  },
  "canary_promotion": {
    "minimum_runs": 5,
    "minimum_pass_rate": 1,
    "receipt_required": true,
    "deterministic_replay_required": true,
    "digest_match_required": true
  },
  "runtime_truth": {
    "append_only_heartbeat_samples": true,
    "completed_tick_samples_required": 3,
    "same_commit_required": true,
    "scheduler_auto_verification": true,
    "configuration_does_not_equal_execution": true
  },
  "auditor_of_auditors": {
    "digest_bound": true,
    "mutation_detection": true,
    "baseline_required": true
  },
  "public_projection": {
    "deterministic": true,
    "stable_skill_ids": true,
    "stable_digests": true,
    "exclude_volatile_timestamps": true,
    "exclude_runtime_telemetry": true,
    "exclude_ephemeral_nonces": true
  },
  "constitutional_boundary": {
    "max_evolvable_autonomy": "L2",
    "hard_veto_classes": [
      "payments",
      "contracts",
      "property_commitments",
      "financing_commitments",
      "rights_or_consent_bypass",
      "secret_exposure",
      "irreversible_governed_deletion",
      "unreceipted_external_action"
    ]
  }
}
