# Browser-safe Lovable UI variables only.
# Never put service_role, CRON_SECRET, CREIXEMENT_OWNER_TOKEN, CREIXEMENT_API_TOKEN or Cloudflare secrets here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Optional public Worker origin used only for safe GET /diagz and /healthz probes.
# Example: https://creixement-kairon.<your-workers-subdomain>.workers.dev
VITE_KAIRON_RUNTIME_URL=
