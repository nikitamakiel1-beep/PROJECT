{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real Estate Counterparty",
  "type": "object",
  "required": ["counterparty_id", "roles", "relationship_status", "contact_authority", "custody_class"],
  "properties": {
    "counterparty_id": {"type": "string", "pattern": "^CP-[A-Z0-9]{8,}$"},
    "generic_company_id": {"type": "string"},
    "generic_contact_id": {"type": "string"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["agency", "owner", "seller", "buyer", "provider", "valuer", "contractor", "property_manager", "lender", "legal_adviser", "other"]}
    },
    "relationship_status": {"enum": ["sourced", "unverified", "verified", "contact_permission_needed", "contacted", "active", "inactive", "blocked"]},
    "contact_authority": {"enum": ["none", "recorded_basis_pending_review", "human_approved", "client_owned"]},
    "agency_registration_status": {"enum": ["not_checked", "claimed", "verified_restricted_evidence", "not_applicable"]},
    "normalized_domain_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_email_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_phone_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "restricted_identity_pointer": {"type": "string", "pattern": "^restricted://"},
    "agreement_pointer": {"type": "string", "pattern": "^restricted://"},
    "custody_class": {"const": "restricted_counterparty"}
  },
  "additionalProperties": false
}
