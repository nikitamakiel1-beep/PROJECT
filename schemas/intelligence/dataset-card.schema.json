{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Dataset Card",
  "type": "object",
  "required": ["dataset_id", "source_class", "lawful_basis", "intended_uses", "prohibited_uses", "tasks", "splits", "pii_review", "seed"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "source_class": {"enum": ["synthetic", "explicitly_approved"]},
    "lawful_basis": {"type": "string", "minLength": 10},
    "intended_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"enum": ["crm", "rag", "vision"]}},
    "splits": {"type": "object", "required": ["crm", "rag", "vision"]},
    "pii_review": {"type": "string"},
    "seed": {"type": "integer"}
  },
  "additionalProperties": true
}
